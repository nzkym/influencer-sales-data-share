# ── 네이버 스마트스토어 세션 쿠키 ─────────────────────────────
# 각 스토어 로그인 후 쿠키를 복사하는 방법:
#   1. sell.smartstore.naver.com 해당 스토어 계정으로 로그인
#   2. 리뷰 관리 페이지로 이동
#   3. F12 → Network 탭 → Fetch/XHR 필터 → 페이지 새로고침
#   4. 목록에서 "search" 요청 클릭
#   5. Headers 탭 → Request Headers → "Cookie:" 값 전체 복사
#   6. 아래 해당 스토어 항목에 붙여넣기
#
# ※ 쿠키는 수개월 유효 (만료 시 텔레그램으로 알림 발송)

NUTONE_COOKIES=
JDHEALTH_COOKIES=
NUTPET_COOKIES=

# ── 텔레그램 (기존 봇/채팅ID 그대로 사용 가능) ───────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Claude API (리뷰 분석용) ─────────────────────────────────
ANTHROPIC_API_KEY=
